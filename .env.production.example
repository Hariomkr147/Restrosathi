# Production Environment Variables Example
DATABASE_URL=postgresql://user:pass@postgres:5432/restrosathi
DOMAIN=demo.restrosathi.com
APP_URL=https://demo.restrosathi.com
POSTGRES_PASSWORD=strong_postgres_password
CRON_SECRET=strong_random_string
SEED_OWNER_PASSWORD=strong_owner_password
SEED_STAFF_PIN=strong_staff_pin
AI_PROVIDER=fake
AI_MODEL=claude-3-haiku-20240307
OPENROUTER_API_KEY=
AI_MONTHLY_CAP=2000
AI_DEVICE_DAILY_LIMIT=20

# Backup settings
BACKUP_ENCRYPTION_KEY=your-32-byte-base64-key-here
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_BUCKET=restrosathi-backups
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false

