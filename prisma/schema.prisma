generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  id                          Int       @id @default(1)
  name                        String
  about                       Json
  address                     String
  phone                       String
  whatsappPhone               String
  ownerAlertPhone             String?
  mapEmbedUrl                 String?
  googleReviewUrl             String?
  hours                       Json
  taxMode                     TaxMode   @default(NONE)
  gstRatePercent              Int       @default(5)
  pricesIncludeTax            Boolean   @default(true)
  gstin                       String?
  fssai                       String?
  staffCanDiscount            Boolean   @default(false)
  taxModeConfirmedAt          DateTime? @db.Timestamptz(3)
  bookingCapacityPerSlot      Int       @default(30)
  maxPartySize                Int       @default(12)
  bookingCutoffMinutes        Int       @default(60)
  loyaltyEnabled              Boolean   @default(false)
  loyaltyEarnPer100Rupees     Int       @default(1)
  loyaltyRedeemUnitPoints     Int       @default(100)
  loyaltyRedeemUnitValuePaise Int       @default(5000)
}

enum TaxMode {
  NONE
  COMPOSITION
  REGULAR
}

enum Role {
  OWNER
  STAFF
}

model User {
  id             String         @id @default(cuid())
  name           String
  phone          String?        @unique
  passwordHash   String?
  pinHash        String?
  role           Role
  active         Boolean        @default(true)
  sessions       AuthSession[]
  auditLogs      AuditLog[]
  bookings       Booking[]
  eventEnquiries EventEnquiry[]
}

model AuthSession {
  tokenHash String   @id
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, at])
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  action   String
  entity   String
  entityId String
  data     Json     @default("{}")
  at       DateTime @default(now()) @db.Timestamptz(3)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
}

enum MenuTag {
  BESTSELLER
  CHEFS_SPECIAL
  NEW
}

model Category {
  id        String     @id @default(cuid())
  name      Json
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id             String          @id @default(cuid())
  categoryId     String
  name           Json
  description    Json?
  basePricePaise Int?
  isVeg          Boolean
  spiceLevel     Int             @default(0)
  tags           MenuTag[]       @default([])
  photoUrl       String?
  available      Boolean         @default(true)
  sortOrder      Int             @default(0)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants       MenuVariant[]
  modifierGroups ModifierGroup[]
  pairings       MenuPairing[]   @relation("PairingSource")
  pairedBy       MenuPairing[]   @relation("PairingTarget")
  orderLines     OrderLine[]

  @@index([categoryId, sortOrder])
}

model MenuVariant {
  id         String   @id @default(cuid())
  itemId     String
  name       Json
  pricePaise Int
  sortOrder  Int      @default(0)
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
}

model ModifierGroup {
  id        String           @id @default(cuid())
  itemId    String
  name      Json
  min       Int
  max       Int
  sortOrder Int              @default(0)
  item      MenuItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options   ModifierOption[]

  @@index([itemId, sortOrder])
}

model ModifierOption {
  id              String        @id @default(cuid())
  groupId         String
  name            Json
  priceDeltaPaise Int
  sortOrder       Int           @default(0)
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

model MenuPairing {
  itemId       String
  pairedItemId String
  sortOrder    Int      @default(0)
  item         MenuItem @relation("PairingSource", fields: [itemId], references: [id], onDelete: Cascade)
  pairedItem   MenuItem @relation("PairingTarget", fields: [pairedItemId], references: [id], onDelete: Cascade)

  @@id([itemId, pairedItemId])
}

model RestaurantTable {
  id        String          @id @default(cuid())
  label     String          @unique
  code      String          @unique
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  sessions  DiningSession[]
}

enum SessionKind {
  DINE_IN
  TAKEAWAY
}

enum SessionStatus {
  OPEN
  BILL_REQUESTED
  CLOSED
}

model DiningSession {
  id                      String           @id @default(cuid())
  kind                    SessionKind
  tableId                 String?
  status                  SessionStatus    @default(OPEN)
  openedAt                DateTime         @default(now()) @db.Timestamptz(3)
  closedAt                DateTime?        @db.Timestamptz(3)
  customerName            String?
  customerPhone           String?
  customerPhoneVerifiedAt DateTime?
  table                   RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders                  Order[]
  requests                ServiceRequest[]
  bill                    Bill?
}

enum ServiceKind {
  CALL_WAITER
  REQUEST_BILL
}

model ServiceRequest {
  id           String        @id @default(cuid())
  sessionId    String
  kind         ServiceKind
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime?     @db.Timestamptz(3)
  resolvedById String?
  session      DiningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, kind, resolvedAt])
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  SERVED
  REJECTED
}

enum OrderSource {
  QR
  STAFF
}

model Order {
  id             String        @id @default(cuid())
  sessionId      String
  idempotencyKey String        @unique
  source         OrderSource
  status         OrderStatus   @default(NEW)
  placedAt       DateTime      @default(now()) @db.Timestamptz(3)
  escalatedAt    DateTime?     @db.Timestamptz(3)
  acceptedAt     DateTime?     @db.Timestamptz(3)
  readyAt        DateTime?     @db.Timestamptz(3)
  servedAt       DateTime?     @db.Timestamptz(3)
  rejectedAt     DateTime?     @db.Timestamptz(3)
  rejectReason   String?
  customerName   String?
  session        DiningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  lines          OrderLine[]

  @@index([sessionId, placedAt])
}

model OrderLine {
  id                String    @id @default(cuid())
  orderId           String
  itemId            String?
  nameSnapshot      Json
  variantSnapshot   Json?
  modifiersSnapshot Json
  qty               Int
  unitPricePaise    Int
  note              String?
  voidedAt          DateTime? @db.Timestamptz(3)
  voidReason        String?
  voidedById        String?
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  item              MenuItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model RateHit {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, at])
}

model AiUsage {
  month  String  @id
  calls  Int     @default(0)
  warned Boolean @default(false)
}

model AiDeviceUsage {
  deviceId String
  day      String
  calls    Int    @default(0)

  @@id([deviceId, day])
}

enum DocType {
  BILL
  BILL_OF_SUPPLY
  TAX_INVOICE
}

enum BillStatus {
  OPEN
  SETTLED
  CANCELLED
}

enum DiscountType {
  FLAT
  PERCENT
}

model Bill {
  id                    String        @id @default(cuid())
  sessionId             String        @unique
  docType               DocType
  status                BillStatus    @default(OPEN)
  number                String?       @unique
  taxMode               TaxMode
  gstRatePercent        Int
  pricesIncludeTax      Boolean
  header                Json
  subtotalPaise         Int
  discountType          DiscountType?
  discountValue         Int?
  discountPaise         Int
  discountReason        String?
  taxableValuePaise     Int
  cgstPaise             Int
  sgstPaise             Int
  roundOffPaise         Int
  totalPaise            Int
  loyaltyPointsRedeemed Int           @default(0)
  loyaltyDiscountPaise  Int           @default(0)
  customerName          String?
  customerPhone         String?
  phoneVerifiedAt       DateTime?
  marketingConsent      Boolean?
  generatedAt           DateTime      @default(now()) @db.Timestamptz(3)
  generatedById         String
  settledAt             DateTime?     @db.Timestamptz(3)
  settledById           String?
  cancelledAt           DateTime?     @db.Timestamptz(3)
  cancelledById         String?
  cancelReason          String?

  session     DiningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  lines       BillLine[]
  payments    Payment[]
  loyaltyTxns LoyaltyTxn[]
  feedback    Feedback?
}

model Customer {
  id          String    @id @default(cuid())
  phone       String    @unique // E.164
  name        String?
  birthday    DateTime? @db.Date
  anniversary DateTime? @db.Date
  verifiedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  consentRecords ConsentRecord[]
  loyaltyTxns    LoyaltyTxn[]
  feedbacks      Feedback[]
}

enum LoyaltyKind {
  EARN
  REDEEM
  ADJUST
  REVERSE
}

model LoyaltyTxn {
  id         String      @id @default(cuid())
  customerId String
  kind       LoyaltyKind
  points     Int
  billId     String?
  reversesId String?     @unique
  note       String?
  actorId    String?
  at         DateTime    @default(now()) @db.Timestamptz(3)

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bill       Bill?       @relation(fields: [billId], references: [id], onDelete: Restrict)
  reverses   LoyaltyTxn? @relation("LoyaltyReverses", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy LoyaltyTxn? @relation("LoyaltyReverses")

  @@index([customerId, at])
  @@index([billId])
}

enum ConsentPurpose {
  MARKETING
}

enum ConsentSource {
  BILLING
  BOOKING
  WHATSAPP_STOP
  ADMIN
}

model ConsentRecord {
  id          String         @id @default(cuid())
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purpose     ConsentPurpose
  granted     Boolean
  textVersion String
  source      ConsentSource
  actorId     String?
  at          DateTime       @default(now()) @db.Timestamptz(3)

  @@index([customerId, purpose, at])
}

model BillLine {
  id             String @id @default(cuid())
  billId         String
  name           Json
  variant        Json?
  modifiers      Json
  qty            Int
  unitPricePaise Int
  linePaise      Int

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

model Payment {
  id           String        @id @default(cuid())
  billId       String
  method       PaymentMethod
  amountPaise  Int
  recordedById String
  at           DateTime      @default(now()) @db.Timestamptz(3)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

model InvoiceCounter {
  fy   String @id
  last Int    @default(0)
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
  RECEIVED
}

model MessageLog {
  id            String           @id @default(cuid())
  direction     MessageDirection
  phone         String
  kind          String?
  locale        String           @default("en")
  params        Json             @default("{}")
  body          String?
  status        MessageStatus
  attempts      Int              @default(0)
  providerId    String?
  externalId    String?          @unique
  lastError     String?
  aiHandled     Boolean          @default(false)
  needsHuman    Boolean          @default(false)
  nextAttemptAt DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
}

model ThreadState {
  phone         String    @id
  aiPausedUntil DateTime? @db.Timestamptz(3)
}

model OptOut {
  phone String   @id
  at    DateTime @default(now()) @db.Timestamptz(3)
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime  @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  ARRIVED
  NO_SHOW
  CANCELLED
}

model Booking {
  id             String        @id @default(uuid())
  name           String
  phone          String
  partySize      Int
  slotStart      DateTime      @db.Timestamptz(3)
  status         BookingStatus @default(REQUESTED)
  note           String?
  locale         String        @default("en")
  cancelToken    String        @unique
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  confirmedAt    DateTime?     @db.Timestamptz(3)
  decidedById    String?
  decidedBy      User?         @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  declineReason  String?
  reminderSentAt DateTime?     @db.Timestamptz(3)

  @@index([slotStart, status])
}

model BlockedDate {
  date   String  @id // YYYY-MM-DD, IST
  reason String?
}

enum EventType {
  BIRTHDAY
  CORPORATE
  OTHER
}

enum EnquiryStatus {
  NEW
  QUOTED
  CONFIRMED
  LOST
}

model EventPackage {
  id                 String  @id @default(uuid())
  name               Json
  description        Json
  pricePerPlatePaise Int
  minGuests          Int
  active             Boolean @default(true)
  sortOrder          Int     @default(0)

  enquiries EventEnquiry[]
}

model EventEnquiry {
  id          String        @id @default(uuid())
  packageId   String?
  eventType   EventType
  name        String
  phone       String
  guests      Int
  eventDate   DateTime      @db.Date
  message     String?
  status      EnquiryStatus @default(NEW)
  quotedPaise Int?
  notes       String?
  locale      String        @default("en")
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  handledById String?

  package   EventPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  handledBy User?         @relation(fields: [handledById], references: [id], onDelete: SetNull)
}

model Feedback {
  id             String    @id @default(uuid())
  billId         String    @unique
  customerId     String?
  token          String    @unique
  tokenExpiresAt DateTime
  rating         Int?
  comment        String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())

  bill           Bill      @relation(fields: [billId], references: [id])
  customer       Customer? @relation(fields: [customerId], references: [id])
}

model BackupRun {
  id         String   @id @default(uuid())
  at         DateTime @default(now()) @db.Timestamptz(3)
  ok         Boolean
  bytes      BigInt?
  objectKey  String?
  error      String?
}

model ErrorLog {
  id      String   @id @default(uuid())
  at      DateTime @default(now()) @db.Timestamptz(3)
  where   String
  message String
  digest  String
}

model AlertState {
  key           String    @id
  active        Boolean
  lastSentAt    DateTime? @db.Timestamptz(3)
  firstFailedAt DateTime? @db.Timestamptz(3)
}
