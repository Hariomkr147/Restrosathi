generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  id              Int     @id @default(1)
  name            String
  about           Json
  address         String
  phone           String
  whatsappPhone   String
  mapEmbedUrl     String?
  googleReviewUrl String?
  hours           Json
}

enum Role {
  OWNER
  STAFF
}

model User {
  id           String        @id @default(cuid())
  name         String
  phone        String?       @unique
  passwordHash String?
  pinHash      String?
  role         Role
  active       Boolean       @default(true)
  sessions     AuthSession[]
  auditLogs    AuditLog[]
}

model AuthSession {
  tokenHash String   @id
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, at])
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  action   String
  entity   String
  entityId String
  data     Json     @default("{}")
  at       DateTime @default(now()) @db.Timestamptz(3)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
}

enum MenuTag {
  BESTSELLER
  CHEFS_SPECIAL
  NEW
}

model Category {
  id        String     @id @default(cuid())
  name      Json
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id             String          @id @default(cuid())
  categoryId     String
  name           Json
  description    Json?
  basePricePaise Int?
  isVeg          Boolean
  spiceLevel     Int             @default(0)
  tags           MenuTag[]       @default([])
  photoUrl       String?
  available      Boolean         @default(true)
  sortOrder      Int             @default(0)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants       MenuVariant[]
  modifierGroups ModifierGroup[]
  pairings       MenuPairing[]   @relation("PairingSource")
  pairedBy       MenuPairing[]   @relation("PairingTarget")

  @@index([categoryId, sortOrder])
}

model MenuVariant {
  id         String   @id @default(cuid())
  itemId     String
  name       Json
  pricePaise Int
  sortOrder  Int      @default(0)
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
}

model ModifierGroup {
  id        String           @id @default(cuid())
  itemId    String
  name      Json
  min       Int
  max       Int
  sortOrder Int              @default(0)
  item      MenuItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options   ModifierOption[]

  @@index([itemId, sortOrder])
}

model ModifierOption {
  id              String        @id @default(cuid())
  groupId         String
  name            Json
  priceDeltaPaise Int
  sortOrder       Int           @default(0)
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

model MenuPairing {
  itemId       String
  pairedItemId String
  sortOrder    Int      @default(0)
  item         MenuItem @relation("PairingSource", fields: [itemId], references: [id], onDelete: Cascade)
  pairedItem   MenuItem @relation("PairingTarget", fields: [pairedItemId], references: [id], onDelete: Cascade)

  @@id([itemId, pairedItemId])
}

model RestaurantTable {
  id        String  @id @default(cuid())
  label     String  @unique
  code      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}
