generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  id              Int     @id @default(1)
  name            String
  about           Json
  address         String
  phone           String
  whatsappPhone   String
  mapEmbedUrl     String?
  googleReviewUrl String?
  hours           Json
}

enum Role {
  OWNER
  STAFF
}

model User {
  id           String        @id @default(cuid())
  name         String
  phone        String?       @unique
  passwordHash String?
  pinHash      String?
  role         Role
  active       Boolean       @default(true)
  sessions     AuthSession[]
  auditLogs    AuditLog[]
}

model AuthSession {
  tokenHash String   @id
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, at])
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  action   String
  entity   String
  entityId String
  data     Json     @default("{}")
  at       DateTime @default(now()) @db.Timestamptz(3)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
}

enum MenuTag {
  BESTSELLER
  CHEFS_SPECIAL
  NEW
}

model Category {
  id        String     @id @default(cuid())
  name      Json
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id             String          @id @default(cuid())
  categoryId     String
  name           Json
  description    Json?
  basePricePaise Int?
  isVeg          Boolean
  spiceLevel     Int             @default(0)
  tags           MenuTag[]       @default([])
  photoUrl       String?
  available      Boolean         @default(true)
  sortOrder      Int             @default(0)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants       MenuVariant[]
  modifierGroups ModifierGroup[]
  pairings       MenuPairing[]   @relation("PairingSource")
  pairedBy       MenuPairing[]   @relation("PairingTarget")
  orderLines     OrderLine[]

  @@index([categoryId, sortOrder])
}

model MenuVariant {
  id         String   @id @default(cuid())
  itemId     String
  name       Json
  pricePaise Int
  sortOrder  Int      @default(0)
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
}

model ModifierGroup {
  id        String           @id @default(cuid())
  itemId    String
  name      Json
  min       Int
  max       Int
  sortOrder Int              @default(0)
  item      MenuItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options   ModifierOption[]

  @@index([itemId, sortOrder])
}

model ModifierOption {
  id              String        @id @default(cuid())
  groupId         String
  name            Json
  priceDeltaPaise Int
  sortOrder       Int           @default(0)
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

model MenuPairing {
  itemId       String
  pairedItemId String
  sortOrder    Int      @default(0)
  item         MenuItem @relation("PairingSource", fields: [itemId], references: [id], onDelete: Cascade)
  pairedItem   MenuItem @relation("PairingTarget", fields: [pairedItemId], references: [id], onDelete: Cascade)

  @@id([itemId, pairedItemId])
}

model RestaurantTable {
  id        String          @id @default(cuid())
  label     String          @unique
  code      String          @unique
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  sessions  DiningSession[]
}

enum SessionKind {
  DINE_IN
  TAKEAWAY
}

enum SessionStatus {
  OPEN
  BILL_REQUESTED
  CLOSED
}

model DiningSession {
  id            String           @id @default(cuid())
  kind          SessionKind
  tableId       String?
  status        SessionStatus    @default(OPEN)
  openedAt      DateTime         @default(now()) @db.Timestamptz(3)
  closedAt      DateTime?        @db.Timestamptz(3)
  customerName  String?
  customerPhone String?
  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders        Order[]
  requests      ServiceRequest[]
}

enum ServiceKind {
  CALL_WAITER
  REQUEST_BILL
}

model ServiceRequest {
  id           String        @id @default(cuid())
  sessionId    String
  kind         ServiceKind
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime?     @db.Timestamptz(3)
  resolvedById String?
  session      DiningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, kind, resolvedAt])
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  SERVED
  REJECTED
}

enum OrderSource {
  QR
  STAFF
}

model Order {
  id             String        @id @default(cuid())
  sessionId      String
  idempotencyKey String        @unique
  source         OrderSource
  status         OrderStatus   @default(NEW)
  placedAt       DateTime      @default(now()) @db.Timestamptz(3)
  acceptedAt     DateTime?     @db.Timestamptz(3)
  readyAt        DateTime?     @db.Timestamptz(3)
  servedAt       DateTime?     @db.Timestamptz(3)
  rejectedAt     DateTime?     @db.Timestamptz(3)
  rejectReason   String?
  customerName   String?
  session        DiningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  lines          OrderLine[]

  @@index([sessionId, placedAt])
}

model OrderLine {
  id                String    @id @default(cuid())
  orderId           String
  itemId            String?
  nameSnapshot      Json
  variantSnapshot   Json?
  modifiersSnapshot Json
  qty               Int
  unitPricePaise    Int
  note              String?
  voidedAt          DateTime? @db.Timestamptz(3)
  voidReason        String?
  voidedById        String?
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  item              MenuItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model RateHit {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, at])
}

model AiUsage {
  month  String  @id
  calls  Int     @default(0)
  warned Boolean @default(false)
}

model AiDeviceUsage {
  deviceId String
  day      String
  calls    Int    @default(0)

  @@id([deviceId, day])
}
