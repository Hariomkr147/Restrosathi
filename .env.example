# Fictional local development credentials; use separate credentials in production.
# Override POSTGRES_PORT and both URL ports if 5432 is already in use.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://restrosathi:restrosathi@127.0.0.1:5432/restrosathi?schema=public"
TEST_DATABASE_URL="postgresql://restrosathi:restrosathi@127.0.0.1:5432/restrosathi_test?schema=public&connection_limit=20&pool_timeout=30"
# Fictional demo login credentials only; replace before using with a real restaurant.
SEED_OWNER_PASSWORD="DemoOwner!2026"
SEED_STAFF_PIN="123456"
SITE_URL="http://localhost:3000"
UPLOAD_DIR="./uploads"
APP_URL="http://localhost:3000"
RATE_LIMIT_IP_ORDERS_PER_HOUR=60
WHATSAPP_PROVIDER=fake
WA_AKG_URL=http://wa-akg:3000
WA_AKG_API_KEY=
WA_AKG_SESSION_ID=
WA_WEBHOOK_SECRET=dev-webhook-secret-change-me
CRON_SECRET=dev-cron-secret-change-me
OTP_SECRET=dev-otp-secret-change-me
COOKIE_SECRET=dev-cookie-secret-change-me
FAKE_WA_OUTBOX=
FAKE_WA_CONTROL=
ALLOW_FAKE_WA=

# Backup settings
BACKUP_ENCRYPTION_KEY=dev-backup-key-32-bytes-long-change-me
S3_ENDPOINT=http://127.0.0.1:4566
S3_BUCKET=restrosathi-backups
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

